---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'Home', current: path === '/' },
  { href: '/resume', label: 'Resume', current: path.startsWith('/resume') },
  { href: '/blog', label: 'Writing', current: path.startsWith('/blog') },
];
---

<header class="site-header">
  <div class="container">
    <a href="/" class="brand" aria-label="Jerome Aaron, home">
      <span class="brand-mark" aria-hidden="true">JA</span>
      <span class="brand-name">Jerome Aaron</span>
    </a>
    <nav class="nav" aria-label="Main">
      <div class="nav-pills">
        {links.map((link) => (
          <a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a>
        ))}
      </div>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to light theme">
        <!-- Shown in dark mode: a sun (switch to light) -->
        <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <!-- Shown in light mode: a moon (switch to dark) -->
        <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;

  function label() {
    const light = root.getAttribute('data-theme') === 'light';
    button?.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
  }

  label();
  button?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
    label();
  });
</script>
