---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Jerome Aaron is a federal IT specialist and AWS Certified Solutions Architect in the Washington, DC area, building cloud infrastructure with AWS, Terraform and GitHub Actions.',
  ogType = 'website',
} = Astro.props;

const siteUrl = 'https://jeromeaaron.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = `${title} | Jerome Aaron`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jerome Aaron',
  jobTitle: 'IT Specialist & Cloud Engineer',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Washington',
    addressRegion: 'DC',
    addressCountry: 'US',
  },
  url: siteUrl,
  sameAs: [
    'https://www.linkedin.com/in/jerome-aaron/',
    'https://github.com/JeromeAaron',
  ],
  knowsAbout: [
    'AWS', 'Cloud Engineering', 'Terraform', 'Infrastructure as Code',
    'CI/CD', 'GitHub Actions', 'Docker', 'Ansible', 'Linux', 'IT Support', 'Federal IT',
  ],
  hasCredential: [
    { '@type': 'EducationalOccupationalCredential', name: 'AWS Certified Solutions Architect – Associate' },
    { '@type': 'EducationalOccupationalCredential', name: 'CompTIA Security+' },
    { '@type': 'EducationalOccupationalCredential', name: 'CompTIA A+' },
    { '@type': 'EducationalOccupationalCredential', name: 'ITIL® Foundations v4' },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Apply a saved theme before first paint so the page never flashes. Dark is the default. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jerome Aaron" />
    <meta name="keywords" content="Jerome Aaron, Cloud Engineer, IT Specialist, Washington DC, AWS, Terraform, Cloud Computing, DevOps, Federal IT" />
    <meta name="theme-color" content="#0B0E13" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Geo targeting (DC Metro) -->
    <meta name="geo.region" content="US-DC" />
    <meta name="geo.placename" content="Washington, DC" />

    <!-- Open Graph (Facebook, LinkedIn previews) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Jerome Aaron" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${siteUrl}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jerome Aaron, federal IT specialist and cloud engineer" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og.png`} />

    <!-- JSON-LD Structured Data: tells Google who Jerome Aaron is -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FNR14ZBW1X"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FNR14ZBW1X');
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: Geist and Geist Mono (Google Fonts is allowed by the CSP) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
