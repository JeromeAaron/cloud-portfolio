---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="tile not-found" aria-labelledby="nf-title">
    <p class="big-number mono">404</p>
    <h1 id="nf-title">This page isn't here.</h1>
    <p class="lede">It may have moved, or it was never deployed. One of these should get you back on track.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn" href="/resume">Resume</a>
      <a class="btn" href="/blog">Writing</a>
    </div>
  </section>
</Layout>
