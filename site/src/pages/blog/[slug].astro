---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import { getPosts, readingTime, formatDate } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
// Long posts get a table of contents built from their H2 headings.
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;
---

<Layout title={post.data.title} description={post.data.description} ogType="article">
  <div class="post-layout">
    <article>
      <header class="post-header">
        <a class="back-link" href="/blog">← All writing</a>
        <p class="post-meta">{formatDate(post.data.date, 'long')} · {readingTime(post)}</p>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        {post.data.tags && (
          <ul class="tags" aria-label="Tags">
            {post.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
      </header>

      {showToc && (
        <details class="toc-mobile">
          <summary>Contents</summary>
          <nav class="toc" aria-label="Contents">
            <ol>
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </nav>
        </details>
      )}

      <div class="prose">
        <Content />
      </div>
    </article>

    {showToc && (
      <aside class="toc-desktop">
        <nav class="toc" aria-label="On this page">
          <p class="tile-label">On this page</p>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      </aside>
    )}
  </div>
</Layout>

<script>
  // Code blocks and tables that scroll sideways need to be reachable by keyboard.
  document.querySelectorAll<HTMLElement>('.prose pre, .prose table').forEach((el) => {
    if (el.scrollWidth > el.clientWidth) el.tabIndex = 0;
  });

  // Highlight the section you're reading in the desktop table of contents.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-desktop .toc a'));
  if (links.length && 'IntersectionObserver' in window) {
    const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((l) => l.classList.remove('active'));
          byId.get(entry.target.id)?.classList.add('active');
        }
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );
    document.querySelectorAll<HTMLElement>('.prose h2[id]').forEach((h) => observer.observe(h));
  }
</script>
