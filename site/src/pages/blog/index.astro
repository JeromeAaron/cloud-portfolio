---
import Layout from '../../layouts/Layout.astro';
import { getPosts, postUrl, readingTime, formatDate } from '../../utils/posts';

const posts = await getPosts();
---

<Layout
  title="Writing"
  description="Jerome Aaron's writing on cloud engineering, AWS, Terraform, homelabs, and moving from federal IT into cloud engineering."
>
  <section class="tile page-head" aria-labelledby="writing-title">
    <p class="eyebrow">Writing</p>
    <h1 id="writing-title">What I built, what broke, and what I learned</h1>
    <p class="lede">
      Write-ups on cloud infrastructure, my homelab, and the move from federal IT into cloud
      engineering. Each post covers a real system I run, including the parts that went wrong.
    </p>
  </section>

  {posts.length === 0 ? (
    <p class="muted">No posts yet. Check back soon.</p>
  ) : (
    <div class="post-list">
      {posts.map((post) => (
        <a class="tile post-card" href={postUrl(post)}>
          <p class="post-meta">{formatDate(post.data.date, 'long')} · {readingTime(post)}</p>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          {post.data.tags && (
            <ul class="tags" aria-label="Tags">
              {post.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </a>
      ))}
    </div>
  )}
</Layout>
