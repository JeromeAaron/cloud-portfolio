---
import Layout from '../layouts/Layout.astro';
import {
  profile, stats, systems, pipeline, safeguards,
  certifications, experience, education, skills,
} from '../data/profile';
import { getPosts, postUrl, readingTime, formatDate } from '../utils/posts';

const posts = (await getPosts()).slice(0, 3);
---

<Layout
  title="Cloud Engineer & Federal IT Specialist in Washington, DC"
  description="Jerome Aaron is a federal IT specialist and AWS Certified Solutions Architect in the Washington, DC area. He builds cloud infrastructure as code with AWS, Terraform and GitHub Actions, and runs his own homelab and local AI lab."
>
  <div class="bento">

    <!-- Intro -->
    <section class="tile hero span-2 rows-2" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">IT Specialist · Cloud Engineer · {profile.location}</p>
        <h1 id="hero-title">Federal IT specialist <span>building cloud infrastructure on AWS.</span></h1>
        <p class="lede">
          Five years supporting federal agencies, from VA Telehealth to disaster response at the
          U.S. Small Business Administration. I'm an AWS Certified Solutions Architect who writes
          infrastructure as code, automates deployments, and runs a working lab to learn what breaks.
        </p>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href="/resume">View resume</a>
        <a class="btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </section>

    <!-- Systems -->
    <section class="tile span-2 rows-2" aria-labelledby="systems-title">
      <div class="tile-head">
        <h2 class="tile-label" id="systems-title">Systems I built and run</h2>
      </div>
      <div class="systems">
        {systems.map((system) => (
          <a class="system" href={system.href}>
            <span class={`dot ${system.status === 'planned' ? 'dot-planned' : 'dot-live'}`} aria-hidden="true"></span>
            <span class="system-body">
              <span class="system-name">{system.name}</span>
              <span class="system-plain">{system.plain}</span>
              <span class="system-tech">{system.tech.join(' · ')}</span>
            </span>
            <span class={`status ${system.status === 'planned' ? 'status-planned' : ''}`}>{system.status}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- At a glance -->
    <section class="tile stats span-full" aria-label="At a glance">
      {stats.map((stat) => (
        <div class="stat">
          <p class="stat-value">{stat.value}</p>
          <p class="stat-label">{stat.label}</p>
        </div>
      ))}
    </section>

    <!-- Deploy pipeline -->
    <section class="tile span-full" aria-labelledby="ship-title">
      <div class="tile-head">
        <h2 class="tile-label" id="ship-title">How this site ships</h2>
        <a class="tile-link" href="/blog/building-cloud-portfolio">How I built it →</a>
      </div>
      <p class="tile-note">
        Every change is tested automatically before it goes live. There are no servers to patch,
        and nothing is clicked together by hand in the AWS console.
      </p>
      <ol class="pipeline">
        {pipeline.map((step, i) => (
          <li class="step">
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="step-tool">{step.tool}</span>
            <span class="step-plain">{step.plain}</span>
          </li>
        ))}
      </ol>
      <div class="ship-detail">
        <div>
          <pre class="term"><span class="prompt">$ terraform plan</span>
<span class="ok">No changes.</span> Your infrastructure matches the configuration.</pre>
          <p class="term-caption">The whole AWS setup lives in Terraform. "No changes" means what's running matches the code exactly.</p>
        </div>
        <ul class="checks">
          {safeguards.map((item) => (
            <li>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9"></path></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Certifications -->
    <section class="tile" aria-labelledby="certs-title">
      <h2 class="tile-label" id="certs-title">Certifications</h2>
      <p class="big-number">{certifications.length}</p>
      <ul class="cert-list">
        {certifications.map((cert) => (
          <li><span>{cert.short}</span><code>{cert.code}</code></li>
        ))}
      </ul>
    </section>

    <!-- Now -->
    <section class="tile" aria-labelledby="now-title">
      <h2 class="tile-label" id="now-title">Now</h2>
      <ul class="now-list">
        <li><span>Day job</span>IT Specialist, U.S. Small Business Administration</li>
        <li><span>Studying</span>B.S. Cloud Computing, WGU, finishing Dec 2026</li>
        <li><span>Building</span>Offsite backups for my homelab on AWS</li>
        <li><span>Based</span>{profile.location}, traveling full-time for work</li>
      </ul>
    </section>

    <!-- Writing -->
    <section class="tile span-2" aria-labelledby="writing-title">
      <div class="tile-head">
        <h2 class="tile-label" id="writing-title">Latest writing</h2>
        <a class="tile-link" href="/blog">All posts →</a>
      </div>
      <div class="post-links">
        {posts.map((post) => (
          <a class="post-link" href={postUrl(post)}>
            <span class="post-link-title">{post.data.title}</span>
            <span class="post-link-desc">{post.data.description}</span>
            <span class="post-meta">{formatDate(post.data.date)} · {readingTime(post)}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section class="tile span-full" aria-labelledby="skills-title">
      <div class="tile-head">
        <h2 class="tile-label" id="skills-title">Tools I work with</h2>
      </div>
      <div class="skill-groups">
        {skills.map((group) => (
          <div class="skill-group">
            <h3>{group.group}</h3>
            <ul class="chips">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

  </div>

  <!-- Experience -->
  <section class="section" aria-labelledby="exp-title">
    <div class="section-head">
      <h2 id="exp-title">Experience</h2>
      <a class="tile-link" href="/resume">Full resume →</a>
    </div>
    <div class="exp-grid">
      {experience.map((job) => (
        <article class="tile">
          <p class="exp-when">{job.dates}</p>
          <h3 class="exp-role">{job.role}</h3>
          <p class="exp-org">{job.org}</p>
          <p class="exp-summary">{job.summary}</p>
        </article>
      ))}
      <article class="tile">
        <p class="exp-when">{education.dates}</p>
        <h3 class="exp-role">{education.degree}</h3>
        <p class="exp-org">{education.school}</p>
        <p class="exp-summary">Coursework that runs alongside the hands-on projects on this site.</p>
      </article>
    </div>
  </section>

  <!-- Contact -->
  <section class="tile cta section" aria-labelledby="cta-title">
    <div>
      <h2 id="cta-title">Get in touch</h2>
      <p>The quickest way to reach me is a message on LinkedIn.</p>
    </div>
    <div class="actions">
      <a class="btn btn-primary" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Message me on LinkedIn ↗</a>
      <a class="btn" href="/resume">View resume</a>
    </div>
  </section>
</Layout>
