---
import Layout from '../layouts/Layout.astro';
import { profile, certifications, experience, education, skills, projects } from '../data/profile';
---

<Layout
  title="Resume"
  description="Resume of Jerome Aaron: federal IT specialist and AWS Certified Solutions Architect in Washington, DC, with CompTIA Security+, A+ and ITIL 4, building infrastructure with Terraform and GitHub Actions."
>
  <section class="tile page-head" aria-labelledby="resume-title">
    <p class="eyebrow no-print">Resume</p>
    <h1 id="resume-title">Jerome Aaron</h1>
    <div class="meta-row">
      <span>{profile.role}</span>
      <span>{profile.location}</span>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <span class="print-only">jeromeaaron.com</span>
    </div>
    <p class="lede">
      Federal IT specialist moving into cloud engineering. AWS Certified Solutions Architect – Associate
      with hands-on experience building production infrastructure using Terraform, CloudFront and
      GitHub Actions CI/CD. Security-first background from federal operations and compliance-driven
      environments. Outside work I run a self-hosted homelab and a local AI lab, both documented on
      this site. Completing a B.S. in Cloud Computing at Western Governors University (Dec 2026).
    </p>
    <div class="actions no-print">
      <button class="btn btn-primary" type="button" data-print>Print or save as PDF</button>
      <a class="btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Message me on LinkedIn ↗</a>
    </div>
  </section>

  <div class="resume-grid">
    <div class="resume-main">
      <section class="tile" aria-labelledby="experience-title">
        <h2 class="tile-label" id="experience-title">Experience</h2>
        {experience.map((job) => (
          <article class="job">
            <div class="job-top">
              <div>
                <h3 class="job-role">{job.role}</h3>
                <p class="job-org">{job.org} · {job.place}</p>
              </div>
              <span class="job-dates">{job.dates}</span>
            </div>
            <ul class="bullets">
              {job.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </article>
        ))}
      </section>

      <section class="tile" aria-labelledby="projects-title">
        <h2 class="tile-label" id="projects-title">Projects</h2>
        {projects.map((project) => (
          <article class="project">
            <h3>
              <a
                class="project-name"
                href={project.href}
                target={project.external ? '_blank' : undefined}
                rel={project.external ? 'noopener noreferrer' : undefined}
              >{project.name}{project.external ? ' ↗' : ''}</a>
            </h3>
            <p>{project.summary}</p>
            <ul class="chips">
              {project.tech.map((tech) => <li>{tech}</li>)}
            </ul>
          </article>
        ))}
      </section>
    </div>

    <aside class="resume-aside" aria-label="Certifications, education and skills">
      <section class="tile" aria-labelledby="certifications-title">
        <h2 class="tile-label" id="certifications-title">Certifications</h2>
        <div class="cert-block">
          {certifications.map((cert) => (
            <div class="cert-item">
              <strong>{cert.name}</strong>
              <span>{cert.issuer} · {cert.code}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="tile" aria-labelledby="education-title">
        <h2 class="tile-label" id="education-title">Education</h2>
        <div class="cert-item">
          <strong>{education.degree}</strong>
          <span>{education.school} · {education.dates}</span>
        </div>
      </section>

      <section class="tile" aria-labelledby="skills-title">
        <h2 class="tile-label" id="skills-title">Skills</h2>
        <div class="aside-skills">
          {skills.map((group) => (
            <div>
              <h3>{group.group}</h3>
              <ul class="chips">
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>
    </aside>
  </div>
</Layout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
